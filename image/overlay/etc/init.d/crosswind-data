#!/sbin/openrc-run
# SPDX-License-Identifier: AGPL-3.0-or-later
# Mounts the persistent data disk (vdb), formatting it on first use, and binds
# Flatpak's installation and the home directory onto it.
description="Crosswind data disk"
depend() { need localmount; }
start() {
    modprobe -q ext4
    blkid /dev/vdb 2>/dev/null | grep -q 'TYPE="ext4"' || mkfs.ext4 -q -L crosswind-data /dev/vdb || return 1
    mkdir -p /data && mount /dev/vdb /data || return 1
    mkdir -p /data/flatpak /data/home /var/lib/flatpak /home
    mount --bind /data/flatpak /var/lib/flatpak
    mount --bind /data/home /home
    # The daemon runs as crosswind (uid 1000): its home persists on the data disk, its runtime dir is tmpfs.
    install -d -o 1000 -g 1000 -m 700 /data/home/crosswind /run/crosswind
    # X11 socket directory for xwayland-satellite (root-owned and sticky, as X servers require); Flatpak binds it into X11 apps.
    install -d -o root -g root -m 1777 /tmp/.X11-unix
    # GTK settings and the Flatpak permission that lets sandboxed apps read them (read-only image files).
    home=/home/crosswind
    mkdir -p $home/.config/gtk-3.0 $home/.config/gtk-4.0 $home/.local/share/flatpak/overrides
    cp /usr/share/crosswind/flatpak/global $home/.local/share/flatpak/overrides/global
    chown -R 1000:1000 $home/.config $home/.local
    mount --bind /usr/share/crosswind/gtk-3.0 $home/.config/gtk-3.0
    mount --bind /usr/share/crosswind/gtk-4.0 $home/.config/gtk-4.0
}
