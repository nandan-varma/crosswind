#!/sbin/openrc-run
# SPDX-License-Identifier: AGPL-3.0-or-later
description="Crosswind guest daemon"
command=/usr/bin/crosswindd
command_background=true
command_user=crosswind:crosswind
export HOME=/home/crosswind
export XDG_RUNTIME_DIR=/run/crosswind
pidfile=/run/crosswind/crosswindd.pid
output_log=/dev/console
error_log=/dev/console
depend() { need dbus crosswind-data; }
