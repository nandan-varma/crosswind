# System-wide defaults: web and mail links go to the host via crosswind-open-url.desktop.
[Default Applications]
x-scheme-handler/http=crosswind-open-url.desktop
x-scheme-handler/https=crosswind-open-url.desktop
x-scheme-handler/mailto=crosswind-open-url.desktop
