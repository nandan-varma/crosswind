# crosswindd's portal backends (guest/crosswindd/src/portal). Served on the session bus.
[portal]
DBusName=org.freedesktop.impl.portal.desktop.crosswind
Interfaces=org.freedesktop.impl.portal.Settings;org.freedesktop.impl.portal.Notification;
UseIn=crosswind
